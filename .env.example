# ═══════════════════════════════════════════════════════════════
#  TALSHYN FLOWERS — айнымалылар тізімі
#  Бұл файлда НАҚТЫ мәндер жоқ. Нақты мәндерді:
#   • Vercel: Project → Settings → Environment Variables
#   • жергілікті/Docker: осы файлды .env деп көшіріп, толтырыңыз
#  .env файлы GitHub-қа ЕШҚАШАН жүктелмейді (.gitignore-да).
# ═══════════════════════════════════════════════════════════════

# ── База (Neon) ─────────────────────────────────────────────────
# Neon → Project → Dashboard → Connect → "Pooled connection" қосулы
DATABASE_URL=
# Neon → сол терезеде "Pooled connection" өшірулі (тікелей қосылым)
# Docker/жергілікті: DATABASE_URL-мен бірдей мән
DATABASE_URL_UNPOOLED=

# ── Админ кіру ──────────────────────────────────────────────────
# Кездейсоқ ұзын жол (кемінде 32 таңба). Генерациялау: docs/SETUP.md
AUTH_SECRET=
# Бірінші OWNER аккаунты (тек база бос кезде бір рет жасалады)
ADMIN_EMAIL=
# Кемінде 10 таңба, әріп + сан. Бірінші кіргенде ауыстыру сұралады.
ADMIN_INITIAL_PASSWORD=

# Сайттың толық адресі, мыс. https://talshyn-flowers.vercel.app
APP_BASE_URL=
# Cron endpoint-терді қорғау (6-кезеңде қажет болады)
CRON_SECRET=

# ── Фото сақтау — Vercel Blob (2-кезең) ────────────────────────
# Vercel → Storage → Blob → Connect арқылы ӨЗІ қойылады. Қолмен толтырмаңыз.
BLOB_READ_WRITE_TOKEN=

# ── WhatsApp Cloud API (3-кезеңде толтырамыз) ───────────────────
# Meta Business → Settings → System users → Generate token (мерзімі: Never)
WHATSAPP_ACCESS_TOKEN=
# developers.facebook.com → App → WhatsApp → API Setup → "Phone number ID"
WHATSAPP_PHONE_NUMBER_ID=
# Сол бет → "WhatsApp Business Account ID"
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Өзіңіз ойлап табасыз (кездейсоқ жол), кейін Meta Console-ға да сол мәнді қоясыз
WHATSAPP_VERIFY_TOKEN=
# developers.facebook.com → App → App settings → Basic → App secret
WHATSAPP_APP_SECRET=
# API Setup бетіндегі мысалдағы нұсқа (бос қалса v23.0)
WHATSAPP_API_VERSION=

# ── Менеджерге хабарлама — Telegram (4-кезеңде толтырамыз) ─────
TELEGRAM_BOT_TOKEN=
TELEGRAM_MANAGER_CHAT_ID=

# ── Тек Docker (docker-compose) үшін ────────────────────────────
POSTGRES_PASSWORD=
